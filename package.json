{
  "name": "radio-capture-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:client:dev && concurrently --kill-others-on-fail --names server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "webpack --config webpack.config.ts --mode development --watch",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc --noEmit -p tsconfig.json && webpack --config webpack.config.ts --mode production",
    "build:client:dev": "webpack --config webpack.config.ts --mode development",
    "build": "npm run build:server && npm run build:client",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/server/scripts/seed.ts",
    "set-prompt": "tsx src/server/scripts/seed.ts set-prompt",
    "set-hotwords": "tsx src/server/scripts/seed.ts set-hotwords",
    "stats": "tsx src/server/scripts/stats.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "docker:build": "docker build -t radio-capture-viewer:latest . && docker build -t radio-capture-viewer:importer-latest ./importer"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "alpinejs": "^3.17.4",
    "better-sqlite3": "^13.0.3",
    "c12": "^4.0.0-rc.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "openai": "^7.39.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "css-loader": "^7.1.5",
    "drizzle-kit": "^0.31.11",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.31",
    "postcss-loader": "^8.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  }
}
